# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bengal_safety_map
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/bengal_safety_map

# Pilot Area Configuration (Greater Kolkata Metropolitan Area)
PILOT_AREA_CODE=kolkata_metro
PILOT_AREA_NAME="Greater Kolkata Pilot (KMC, Bidhannagar, Howrah, New Town)"
PILOT_CENTER_LAT=22.5726
PILOT_CENTER_LON=88.3639
PILOT_DEFAULT_ZOOM=12
PILOT_BBOX_MIN_LON=88.2000
PILOT_BBOX_MIN_LAT=22.4000
PILOT_BBOX_MAX_LON=88.5500
PILOT_BBOX_MAX_LAT=22.7000

# Temporal Policy (Asia/Kolkata IST)
TIMEZONE="Asia/Kolkata"
NIGHT_START_HOUR=20
NIGHT_END_HOUR=5

# Privacy and Aggregation Safeguards
MIN_AGGREGATE_COUNT=5
DEFAULT_SPATIAL_PRECISION="hex_500m"

# Active Dataset Release
ACTIVE_RELEASE_VERSION="synthetic_demo_v1"
